                </button>
                <button id="saveMapBtn" class="btn btn-sm btn-success" 
                        aria-label="Save map changes">
                    <i class="bi bi-save"></i> Save
                </button>
                <button id="clearMapBtn" class="btn btn-sm btn-danger" 
                        aria-label="Clear all drawings">
                    <i class="bi bi-trash"></i> Clear
                </button>
            </div>
        </div>
    </div>
    
