        try {
            window.calendar.refetchEvents();
        } catch (e) {
            console.error('Error refreshing calendar:', e);
        }
    }
    
    // Force chart update after data loads
    setTimeout(() => {
        this.updateHealthChart();
    }, 150);
    
    // Initialize map with a slight delay to ensure DOM is ready
