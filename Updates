Fix 5: Add Error Boundary for Map Container

Add this to your map initialization:

```javascript
initMap: function() {
    const mapContainer = document.getElementById('map');
    if (!mapContainer) {
        console.error('Map element not found');
        return;
    }
    
    // Check if container is visible
    if (mapContainer.offsetParent === null) {
        console.warn('Map container not visible, waiting...');
        // Wait for container to become visible
        const observer = new MutationObserver(() => {
            if (mapContainer.offsetParent !== null) {
                observer.disconnect();
                this.initMap();
            }
        });
        observer.observe(mapContainer, { attributes: true, attributeFilter: ['style', 'class'] });
        return;
    }
    
