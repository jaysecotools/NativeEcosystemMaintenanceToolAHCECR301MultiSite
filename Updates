Most Likely Problem: The Async Functions

The saveAssessment and saveSpecies functions became async (which is correct), but this sometimes affects how other code loads. The map initialization might be trying to run before everything is ready.

Quick Fix - Add a Map Retry

Find the initMap function in your App object (around line 2500-2600). Add a retry mechanism. Replace your existing initMap with this:

```javascript
initMap: function(retryCount = 0) {
    console.log('Initializing map...');
    
    const mapContainer = document.getElementById('map');
    if (!mapContainer) {
        console.error('Map element not found');
        return;
    }

    // Check if Leaflet is available
    if (typeof L === 'undefined') {
        if (retryCount < 5) {
            console.log('Leaflet not ready, retrying in 500ms...');
            setTimeout(() => this.initMap(retryCount + 1), 500);
            return;
        } else {
            mapContainer.innerHTML = '<div class="alert alert-warning">Map library failed to load. Please refresh the page.</div>';
            return;
        }
    }

    const siteId = db.currentSiteId;
    const site = Utils.getCurrentSite();
    
    if (!site) {
        mapContainer.innerHTML = '<div class="alert alert-warning">No site selected.</div>';
        return;
    }
    
    let mapData = db.siteMaps[siteId];
    if (!mapData) {
        mapData = Utils.generateSiteLocation(siteId);
        db.siteMaps[siteId] = mapData;
        Utils.saveData();
    }
    
    try {
        // Clean up existing map
        if (window.map) {
            window.map.remove();
            window.map = null;
        }
        
        // Ensure container has proper dimensions
        mapContainer.style.height = '500px';
        mapContainer.style.width = '100%';
        
        // Clear any existing content
        mapContainer.innerHTML = '';
        
        // Create new map
        window.map = L.map('map', {
            center: mapData.center,
            zoom: 13,
            zoomControl: true,
            fadeAnimation: false,
            zoomAnimation: false
        });

        // Add tile layer
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 19,
            detectRetina: true
        }).addTo(window.map);

        // Add main site marker
        L.marker(mapData.center).addTo(window.map)
            .bindPopup(`<b>${Utils.sanitizeHTML(site.name)}</b><br>${Utils.sanitizeHTML(site.location)}`)
            .openPopup();

        // Create layers
        this.createMapLayers(mapData);
        
        // Initialize editing tools
        if (typeof MapEditor !== 'undefined' && MapEditor.initEditing) {
            MapEditor.initEditing();
        }
        
        // Force map to recalculate size
        setTimeout(() => {
            if (window.map) {
                window.map.invalidateSize(true);
                console.log('Map size invalidated');
            }
        }, 250);
        
        console.log('Map initialized successfully');
        
    } catch (error) {
        console.error('Error initializing map:', error);
        mapContainer.innerHTML = '<div class="alert alert-warning">Map could not be loaded. Please refresh the page.</div>';
    }
},
```

