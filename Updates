<div class="map-container" role="region" aria-label="Interactive site map">
    <div id="map"></div>
    <div id="mapFallback" style="display: none; text-align: center; padding: 20px;">
        <i class="bi bi-map"></i>
        <p>Map is loading. Please wait...</p>
    </div>
    
    <div class="map-controls" role="group" aria-label="Map controls">
        <div class="btn-group-vertical w-100">
            <div class="btn-group">
                <button id="zoneToggle" class="btn btn-sm btn-outline-primary active" 
                        aria-pressed="true" aria-label="Toggle zones layer">
