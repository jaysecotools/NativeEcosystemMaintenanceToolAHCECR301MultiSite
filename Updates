initMap: function(retryCount = 0) {
    const maxRetries = 10;
    const statusDiv = document.getElementById('mapInitStatus');
    
    // Log for debugging (optional - remove in production)
    if (statusDiv) {
        statusDiv.style.display = 'block';
        statusDiv.innerHTML = `initMap() called (attempt ${retryCount + 1}/${maxRetries}) at ${new Date().toLocaleTimeString()}`;
    }
    
    // Check if Leaflet is loaded
    if (typeof L === 'undefined') {
        console.warn('Leaflet not loaded, retry ' + (retryCount + 1));
        if (retryCount < maxRetries) {
            setTimeout(() => this.initMap(retryCount + 1), 500);
        } else if (statusDiv) {
            statusDiv.innerHTML = 'ERROR: Leaflet library failed to load after ' + maxRetries + ' attempts';
            statusDiv.style.background = '#ffcccc';
        }
        return;
    }
    
    // Check if dashboard tab is active
    const dashboardPane = document.getElementById('dashboard');
    const isDashboardActive = dashboardPane && 
                              dashboardPane.classList.contains('show') && 
                              dashboardPane.classList.contains('active');
    
    if (!isDashboardActive) {
        console.log('Dashboard not active, waiting...');
        if (retryCount < maxRetries) {
            setTimeout(() => this.initMap(retryCount + 1), 300);
        }
        return;
    }
    
    // Check if map container exists
    const mapContainer = document.getElementById('map');
    if (!mapContainer) {
        console.error('Map container not found');
        if (retryCount < maxRetries) {
            setTimeout(() => this.initMap(retryCount + 1), 300);
        }
        return;
    }
    
    // Ensure container has proper dimensions
    mapContainer.style.height = '500px';
    mapContainer.style.width = '100%';
    mapContainer.innerHTML = ''; // Clear any existing content
    
    // Get current site
    const siteId = db.currentSiteId;
    const site = Utils.getCurrentSite();
    
    if (!site) {
        mapContainer.innerHTML = '<div class="alert alert-warning">No site selected. Please create or select a site.</div>';
        if (statusDiv) statusDiv.innerHTML = 'ERROR: No site selected';
        return;
    }
    
    // Get or generate map data
    let mapData = db.siteMaps[siteId];
    if (!mapData || !mapData.center || !Array.isArray(mapData.center)) {
        console.log('Invalid map data, regenerating...');
        mapData = Utils.generateSiteLocation(siteId);
        db.siteMaps[siteId] = mapData;
        Utils.saveData();
    }
    
    // Destroy existing map if any
    if (window.map) {
        try {
            window.map.remove();
        } catch(e) {
            console.warn('Error removing existing map:', e);
        }
        window.map = null;
    }
    
    try {
        // Create new map
        window.map = L.map('map', {
            center: mapData.center,
            zoom: 13,
            zoomControl: true,
            fadeAnimation: false, // Better performance
            zoomAnimation: false
        });
        
        // Add tile layer with error handling
        const tileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 19,
            errorTileUrl: '' // Prevent error image
        }).addTo(window.map);
        
        // Handle tile loading errors
        tileLayer.on('tileerror', function(error) {
            console.warn('Tile failed to load:', error);
        });
        
        // Add main site marker
        L.marker(mapData.center).addTo(window.map)
            .bindPopup(`<b>${Utils.sanitizeHTML(site.name)}</b><br>${Utils.sanitizeHTML(site.location)}`)
            .openPopup();
        
        // Create map layers
        this.createMapLayers(mapData);
        
        // Initialize editing tools with safety check
        if (typeof MapEditor !== 'undefined' && MapEditor.initEditing) {
            try {
                MapEditor.initEditing();
            } catch(e) {
                console.warn('Map editing not available:', e);
            }
        }
        
        // Force map to recalculate size after a moment
        setTimeout(() => {
            if (window.map) {
                window.map.invalidateSize(true);
                console.log('Map size invalidated');
            }
        }, 200);
        
        // Additional resize on window resize
        const resizeHandler = () => {
            if (window.map) {
                window.map.invalidateSize(true);
            }
        };
        window.removeEventListener('resize', resizeHandler);
        window.addEventListener('resize', resizeHandler);
        
        if (statusDiv) {
            statusDiv.innerHTML = '✅ Map loaded successfully!';
            statusDiv.style.background = '#ccffcc';
            setTimeout(() => {
                if (statusDiv) statusDiv.style.display = 'none';
            }, 3000);
        }
        
        console.log('Map initialized successfully for site:', site.name);
        
    } catch (error) {
        console.error('Map creation failed:', error);
        mapContainer.innerHTML = `
            <div class="alert alert-danger">
                <strong>Map Error:</strong> ${error.message}<br>
                <button onclick="location.reload()" class="btn btn-sm btn-primary mt-2">
                    Reload Page
                </button>
            </div>
        `;
        if (statusDiv) {
            statusDiv.innerHTML = '❌ Map creation failed: ' + error.message;
            statusDiv.style.background = '#ffcccc';
        }
    }
}
