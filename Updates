initCalendar: function(retryCount = 0) {
    const maxRetries = 10;
    const calendarEl = document.getElementById('calendar');
    
    if (!calendarEl) {
        console.warn('Calendar element not found');
        if (retryCount < maxRetries) {
            setTimeout(() => this.initCalendar(retryCount + 1), 500);
        }
        return;
    }
    
    // Check if FullCalendar is loaded
    if (typeof FullCalendar === 'undefined') {
        console.warn('FullCalendar not loaded, retry ' + (retryCount + 1));
        if (retryCount < maxRetries) {
            setTimeout(() => this.initCalendar(retryCount + 1), 500);
        } else {
            calendarEl.innerHTML = '<div class="alert alert-warning">Calendar could not be loaded. Please refresh the page.</div>';
        }
        return;
    }
    
    // Check if maintenance tab is active (for proper sizing)
    const maintenancePane = document.getElementById('maintenance-plan');
    const isMaintenanceActive = maintenancePane && 
                                maintenancePane.classList.contains('show') && 
                                maintenancePane.classList.contains('active');
    
    // Prepare events
    const events = Utils.filterByCurrentSite(db.activities).map(activity => {
        if (!activity) return null;
        return {
            id: activity.id.toString(),
            title: activity.title,
            start: activity.startDate,
            end: activity.endDate || activity.startDate,
            allDay: true,
            extendedProps: {
                type: activity.type,
                location: activity.location,
                assignedTo: activity.assignedTo,
                status: activity.status
            },
            backgroundColor: this.getActivityColor(activity.type),
            borderColor: this.getActivityColor(activity.type),
            textColor: '#fff'
        };
    }).filter(e => e !== null);
    
    // Ensure container has minimum height
    calendarEl.style.minHeight = '600px';
    
    // Destroy existing calendar if any
    if (window.calendar) {
        try {
            window.calendar.destroy();
        } catch(e) {
            console.warn('Error destroying existing calendar:', e);
        }
        window.calendar = null;
    }
    
    try {
        // Create new calendar
        window.calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: events,
            eventClick: (info) => {
                const activity = db.activities.find(a => a && a.id.toString() === info.event.id);
                if (activity) this.showActivityDetails(activity);
            },
            height: 600,
            stickyHeaderDates: true,
            handleWindowResize: true,
            contentHeight: 'auto',
            aspectRatio: 1.5,
            nowIndicator: true,
            eventTimeFormat: {
                hour: '2-digit',
                minute: '2-digit',
                meridiem: false
            }
        });
        
        window.calendar.render();
        
        // If calendar is in hidden tab, mark it for refresh when shown
        if (!isMaintenanceActive) {
            window.calendarNeedsRefresh = true;
            console.log('Calendar initialized in hidden tab - will refresh when shown');
        } else {
            // Calendar is visible, ensure proper sizing
            setTimeout(() => {
                if (window.calendar) {
                    window.calendar.updateSize();
                    console.log('Calendar size updated');
                }
            }, 100);
        }
        
        console.log('Calendar initialized successfully');
        
    } catch (error) {
        console.error('Calendar initialization failed:', error);
        calendarEl.innerHTML = '<div class="alert alert-warning">Calendar could not be loaded. Please refresh the page.</div>';
    }
}
