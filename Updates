    compressImage: function(base64String, maxWidth = 800, maxHeight = 800, quality = 0.7) {
        return new Promise((resolve) => {
            const img = new Image();
            img.onload = function() {
                let width = img.width;
                let height = img.height;
                
                // Calculate new dimensions while maintaining aspect ratio
                if (width > height) {
                    if (width > maxWidth) {
                        height = Math.round(height * (maxWidth / width));
                        width = maxWidth;
                    }
                } else {
                    if (height > maxHeight) {
                        width = Math.round(width * (maxHeight / height));
                        height = maxHeight;
                    }
                }
                
                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);
                
                // Compress and convert back to base64
                const compressedBase64 = canvas.toDataURL('image/jpeg', quality);
                resolve(compressedBase64);
            };
            img.onerror = function() {
                resolve(base64String); // Return original if compression fails
            };
            img.src = base64String;
        });
    },

    convertImageToBase64: function(file, maxSizeKB = 500) {
        return new Promise((resolve, reject) => {
            if (!file || !file.type.startsWith('image/')) {
                resolve(null);
                return;
            }
            
            // Check file size before processing
            if (file.size > 5 * 1024 * 1024) { // 5MB limit
                this.showToast('Warning', `Image ${file.name} exceeds 5MB and was skipped`, 'warning');
                resolve(null);
                return;
            }
            
            const reader = new FileReader();
            reader.onload = async function(e) {
                let base64 = e.target.result;
                
                // Compress the image
                base64 = await Utils.compressImage(base64, 800, 800, 0.7);
                
                // Check final size and warn if still large
                const sizeInKB = Math.round(base64.length * 0.75 / 1024);
                if (sizeInKB > maxSizeKB) {
                    Utils.showToast('Info', `Image compressed to ${sizeInKB}KB`, 'info');
                }
                
                resolve(base64);
            };
            reader.onerror = function(e) {
                console.error('Error converting image:', e);
                reject(null);
            };
            reader.readAsDataURL(file);
        });
    },

