initMap: function() {
    console.log('Initializing map...');
    
    const mapContainer = document.getElementById('map');
    if (!mapContainer) {
        console.error('Map element not found - retrying in 500ms');
        setTimeout(() => this.initMap(), 500);
        return;
    }
    
    // Check if Leaflet is loaded
