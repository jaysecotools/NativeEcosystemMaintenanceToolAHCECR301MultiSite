                        form.reset();
                        form.classList.remove('was-validated');
                        bootstrap.Modal.getInstance(document.getElementById('modalNewSite')).hide();
                        Utils.showToast('Success', 'Site created successfully');
                        
                        this.loadSiteSelector();
                        
                        if (db.sites.length === 1) {
                            db.currentSiteId = newSite.id;
                            this.loadSiteSelector();
                            App.loadAllData();
                        }
                    }
                },

                confirmDeleteSite: function(siteId, siteName) {
                    Utils.showConfirmation(
                        'Delete Site',
                        'Are you sure you want to delete "${siteName}"? This will permanently delete all data associated with this site.',
                        () => this.deleteSite(siteId)
                    );
                },

                deleteSite: function(siteId) {
                    db.sites = db.sites.filter(s => s && s.id !== siteId);
                    delete db.siteMaps[siteId];
                    delete db.mapFeatures[siteId];
                    
                    db.assessments = db.assessments.filter(a => a && a.siteId !== siteId);
                    db.species = db.species.filter(s => s && s.siteId !== siteId);
                    db.activities = db.activities.filter(a => a && a.siteId !== siteId);
                    db.monitoring = db.monitoring.filter(m => m && m.siteId !== siteId);
                    db.reports = db.reports.filter(r => r && r.siteId !== siteId);
                    db.faunaSightings = db.faunaSightings.filter(f => f && f.siteId !== siteId);
                    db.vegetationSurveys = db.vegetationSurveys.filter(v => v && v.siteId !== siteId);
                    
                    if (db.currentSiteId === siteId) {
                        db.currentSiteId = db.sites.length > 0 ? db.sites[0].id : null;
                    }
                    
                    if (Utils.saveData()) {
                        Utils.showToast('Success', 'Site deleted successfully');
                        this.loadSiteSelector();
                        App.loadAllData();
                    }
                },

                promptSwitchSite: function(siteId, siteName) {
                    const switchTargetId = document.getElementById('switchTargetSiteId');
                    const switchTargetName = document.getElementById('switchTargetSiteName');
                    
                    if (switchTargetId) switchTargetId.value = siteId;
                    if (switchTargetName) switchTargetName.textContent = siteName;
                    
                    new bootstrap.Modal(document.getElementById('modalSwitchSite')).show();
                },

                switchSite: function(siteId) {
                    Utils.saveData();
                    db.currentSiteId = siteId;
                    this.loadSiteSelector();
                    App.populateModalSiteIds();
                    
                    setTimeout(() => {
                        App.updateHealthChart();
                    }, 100);
                    
                    setTimeout(() => {
                        App.loadAllData();
                    }, 200);
                    
                    setTimeout(() => {
                        if (window.map) {
                            App.initMap();
                        } else {
                            App.initMap();
                        }
                    }, 300);
                    
                    bootstrap.Modal.getInstance(document.getElementById('modalSwitchSite')).hide();
                    
                    const site = db.sites.find(s => s && s.id === siteId);
                    Utils.showToast('Success', 'Switched to ' + (site ? site.name : 'site'));
                }
            };

            // ==================== CORE APP FUNCTIONS ====================
            const App = {
                init: function() {
                    if (!checkDependencies()) {
                        console.warn('Application running with missing dependencies');
                    }
                    
                    Utils.loadData();
                    SiteManager.initSites();
                    this.loadInitialData();
                    
                    setTimeout(() => {
                        this.initCharts();
                        this.initCalendar();
                        this.populateModalSiteIds();
                        this.loadAllData();
                        this.setupEventListeners();
                        this.updateStorageInfo();
                        
                        setTimeout(() => {
                            this.initMap();
                        }, 600);
                        
                        db.initialized = true;
                    }, 500);
                },

                populateModalSiteIds: function() {
                    const siteId = db.currentSiteId || '';
                    const activityInput = document.getElementById('activitySiteId');
                    const assessmentInput = document.getElementById('assessmentSiteId');
                    const speciesInput = document.getElementById('speciesSiteId');
                    const monitoringInput = document.getElementById('monitoringSiteId');
                    const faunaInput = document.getElementById('faunaSiteId');
                    const vegetationInput = document.getElementById('vegetationSiteId');
                    
                    if (activityInput) activityInput.value = siteId;
                    if (assessmentInput) assessmentInput.value = siteId;
                    if (speciesInput) speciesInput.value = siteId;
                    if (monitoringInput) monitoringInput.value = siteId;
                    if (faunaInput) faunaInput.value = siteId;
                    if (vegetationInput) vegetationInput.value = siteId;
                },

                loadAllData: function() {
                    this.loadDashboard();
                    this.loadAssessments();
                    this.loadSpecies();
                    this.loadActivities();
                    this.loadMonitoring();
                    this.loadReports();
                    this.loadComplianceChecklist();
                    this.loadSettings();
                    this.populateModalSiteIds();
                    
                    if (window.calendar) {
                        try {
                            window.calendar.refetchEvents();
                        } catch (e) {
                            console.error('Error refreshing calendar:', e);
                        }
                    }
                    
                    setTimeout(() => {
                        this.updateHealthChart();
                    }, 150);
                    
                    // Only reinitialize map if it exists
                    if (window.map) {
                        setTimeout(() => {
                            if (window.map) {
                                window.map.invalidateSize();
                            }
                        }, 200);
                    }
                },

                updateHealthChart: function() {
                    const canvas = document.getElementById('healthChart');
                    if (!canvas) return;
                    
                    const healthData = Utils.getSiteHealthData(db.currentSiteId);
                    const siteName = Utils.getCurrentSite()?.name || 'this site';
                    
                    if (window.healthChart) {
                        try {
                            window.healthChart.destroy();
                        } catch (e) {
                            console.error('Error destroying existing chart:', e);
                        }
                        window.healthChart = null;
                    }
                    
                    const ctx = canvas.getContext('2d');
                    
                    try {
                        if (typeof Chart === 'undefined') {
                            console.error('Chart.js not loaded');
                            return;
                        }
                        
                        window.healthChart = new Chart(ctx, {
                            type: 'radar',
                            data: {
                                labels: ['Biodiversity', 'Native Cover', 'Weed Pressure', 'Erosion', 'Fauna Activity', 'Water Quality'],
                                datasets: [{
                                    label: 'Current',
                                    data: [
                                        healthData.biodiversity,
                                        healthData.nativeCover,
                                        healthData.weedPressure,
                                        healthData.erosion,
                                        healthData.faunaActivity,
                                        healthData.waterQuality
                                    ],
                                    backgroundColor: 'rgba(40, 167, 69, 0.2)',
                                    borderColor: 'rgba(40, 167, 69, 1)',
                                    borderWidth: 2,
                                    pointBackgroundColor: 'rgba(40, 167, 69, 1)'
                                }, {
                                    label: 'Previous',
                                    data: [
                                        healthData.previousBiodiversity,
                                        healthData.previousNativeCover,
                                        healthData.previousWeedPressure,
                                        healthData.previousErosion,
                                        healthData.previousFaunaActivity,
                                        healthData.previousWaterQuality
                                    ],
                                    backgroundColor: 'rgba(108, 117, 125, 0.1)',
                                    borderColor: 'rgba(108, 117, 125, 0.8)',
                                    borderWidth: 2,
                                    pointBackgroundColor: 'rgba(108, 117, 125, 0.8)'
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: true,
                                scales: {
                                    r: {
                                        beginAtZero: true,
                                        max: 100,
                                        ticks: {
                                            stepSize: 20,
                                            callback: (value) => value + '%'
                                        }
                                    }
                                },
                                plugins: {
                                    legend: {
                                        position: 'bottom'
                                    },
                                    tooltip: {
                                        callbacks: {
                                            label: (context) => {
                                                return context.dataset.label + ': ' + context.raw + '%';
                                            }
                                        }
                                    }
                                }
                            }
                        });
                        
                        console.log('Health chart updated for site:', siteName);
                        
                    } catch (error) {
                        console.error('Error updating health chart:', error);
                    }
                    
                    const indicatorsDiv = document.getElementById('healthIndicators');
                    if (indicatorsDiv) {
                        const assessmentCount = Utils.filterByCurrentSite(db.assessments).length;
                        indicatorsDiv.innerHTML = '
                            <div class="alert alert-info small">
                                <i class="bi bi-info-circle me-2"></i>
                                Health data based on ${assessmentCount} assessment(s) for ${siteName}.
                            </div>
                        ';
                    }
                },

                // ==================== MAP INITIALIZATION - FIXED ====================
                initMap: function() {
                    console.log('Starting map initialization...');
                    
                    const mapContainer = document.getElementById('map');
                    if (!mapContainer) {
                        console.error('Map container not found');
                        return;
                    }
                    
                    const site = Utils.getCurrentSite();
                    if (!site) {
                        mapContainer.innerHTML = '<div class="alert alert-warning">No site selected</div>';
                        return;
                    }
                    
                    let mapData = db.siteMaps[db.currentSiteId];
                    if (!mapData) {
                        mapData = Utils.generateSiteLocation(db.currentSiteId);
                        db.siteMaps[db.currentSiteId] = mapData;
                    }
                    
                    // Clear existing map
                    if (window.map) {
                        try { window.map.remove(); } catch(e) {}
                        window.map = null;
                    }
                    
                    try {
                        // Clear container
                        mapContainer.innerHTML = '';
                        
                        // Initialize map with explicit size
                        window.map = L.map('map', {
                            center: mapData.center,
                            zoom: 13,
                            zoomControl: true,
                            attributionControl: true
                        });
                        
                        // Add tile layer
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            attribution: '&copy; OpenStreetMap contributors'
                        }).addTo(window.map);
                        
                        // Force map to resize properly
                        setTimeout(function() {
                            if (window.map) {
                                window.map.invalidateSize();
                                console.log('Map initial resize complete');
                            }
                        }, 100);
                        
                        // Additional resize after a longer delay
                        setTimeout(function() {
                            if (window.map) {
                                window.map.invalidateSize();
                                console.log('Map secondary resize complete');
                            }
                        }, 300);
                        
                        // Add site marker
                        L.marker(mapData.center).bindPopup('<b>' + site.name + '</b>').addTo(window.map);
                        
                        // Create map layers
                        this.createMapLayers(mapData);
                        
                        // Initialize editing after map is ready
                        setTimeout(function() {
                            MapEditor.initEditing();
                        }, 400);
                        
                        console.log('Map loaded successfully for site:', site.name);
                        
                    } catch(error) {
                        console.error('Map error:', error);
                        mapContainer.innerHTML = '<div class="alert alert-danger">Map failed to load: ' + error.message + '</div>';
                    }
                },

                createMapLayers: function(mapData) {
                    if (!mapData || !window.map) return;
                    
                    // Clear existing layers
                    if (window.zonesLayer) {
                        try { window.zonesLayer.clearLayers(); } catch(e) {}
                    }
                    if (window.vegetationLayer) {
                        try { window.vegetationLayer.clearLayers(); } catch(e) {}
                    }
                    if (window.weedsLayer) {
                        try { window.weedsLayer.clearLayers(); } catch(e) {}
                    }
                    
                    window.zonesLayer = L.layerGroup();
                    window.vegetationLayer = L.layerGroup();
                    window.weedsLayer = L.layerGroup();
                    
                    if (mapData.zones) {
                        mapData.zones.forEach(zone => {
                            if (zone && zone.coords) {
                                try {
                                    const polygon = L.polygon(zone.coords, {
                                        color: zone.color,
                                        weight: 2,
                                        opacity: 0.8,
                                        fillOpacity: 0.2
                                    }).bindPopup('<b>' + zone.name + '</b>');
                                    window.zonesLayer.addLayer(polygon);
                                } catch (e) {
                                    console.error('Error creating zone polygon:', e);
                                }
                            }
                        });
                    }
                    
                    if (mapData.vegetationMarkers) {
                        mapData.vegetationMarkers.forEach(markerData => {
                            if (markerData && markerData.coords) {
                                try {
                                    const marker = L.circleMarker(markerData.coords, {
                                        radius: 8,
                                        color: '#27ae60',
                                        fillColor: '#27ae60',
                                        fillOpacity: 0.8
                                    }).bindPopup('<b>Vegetation:</b> ' + markerData.name);
                                    window.vegetationLayer.addLayer(marker);
                                } catch (e) {
                                    console.error('Error creating vegetation marker:', e);
                                }
                            }
                        });
                    }
                    
                    if (mapData.weedMarkers) {
                        mapData.weedMarkers.forEach(markerData => {
                            if (markerData && markerData.coords) {
                                try {
                                    const marker = L.circleMarker(markerData.coords, {
                                        radius: 8,
                                        color: '#e74c3c',
                                        fillColor: '#e74c3c',
                                        fillOpacity: 0.8
                                    }).bindPopup('<b>Weed:</b> ' + markerData.name);
                                    window.weedsLayer.addLayer(marker);
                                } catch (e) {
                                    console.error('Error creating weed marker:', e);
                                }
                            }
                        });
                    }

                    // Add zones layer by default
                    if (window.zonesLayer) {
                        window.zonesLayer.addTo(window.map);
                    }
                    
                    const zoneToggle = document.getElementById('zoneToggle');
                    const vegToggle = document.getElementById('vegetationToggle');
                    const weedsToggle = document.getElementById('weedsToggle');
                    
                    if (zoneToggle) {
                        zoneToggle.classList.add('active');
                        zoneToggle.setAttribute('aria-pressed', 'true');
                    }
                    if (vegToggle) {
                        vegToggle.classList.remove('active');
                        vegToggle.setAttribute('aria-pressed', 'false');
                    }
                    if (weedsToggle) {
                        weedsToggle.classList.remove('active');
                        weedsToggle.setAttribute('aria-pressed', 'false');
                    }
                },

                updateMapForCurrentSite: function() {
                    this.initMap();
                },

                initCalendar: function() {
                    const calendarEl = document.getElementById('calendar');
                    if (!calendarEl) return;

                    if (typeof FullCalendar === 'undefined') {
                        calendarEl.innerHTML = '<div class="alert alert-warning">Calendar could not be loaded.</div>';
                        return;
                    }

                    const events = Utils.filterByCurrentSite(db.activities).map(activity => {
                        if (!activity) return null;
                        return {
                            id: activity.id.toString(),
                            title: activity.title,
                            start: activity.startDate,
                            end: activity.endDate || activity.startDate,
                            extendedProps: {
                                type: activity.type,
                                location: activity.location,
                                assignedTo: activity.assignedTo,
                                status: activity.status
                            },
                            backgroundColor: this.getActivityColor(activity.type),
                            borderColor: this.getActivityColor(activity.type),
                            textColor: '#fff'
                        };
                    }).filter(e => e !== null);

                    if (window.calendar) {
                        try { window.calendar.destroy(); } catch(e) {}
                    }

                    window.calendar = new FullCalendar.Calendar(calendarEl, {
                        initialView: 'dayGridMonth',
                        headerToolbar: {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'dayGridMonth,timeGridWeek,timeGridDay'
                        },
                        events: events,
                        eventClick: (info) => {
                            const activity = db.activities.find(a => a && a.id.toString() === info.event.id);
                            if (activity) this.showActivityDetails(activity);
                        },
                        height: 600,
                        stickyHeaderDates: true
                    });

                    window.calendar.render();
                },

                getActivityColor: function(type) {
                    const colors = {
                        'weed-control': '#dc3545',
                        'revegetation': '#28a745',
                        'erosion-control': '#fd7e14',
                        'fauna-survey': '#17a2b8',
                        'vegetation-survey': '#20c997',
                        'water-quality': '#007bff'
                    };
                    return colors[type] || '#6c757d';
                },

                loadDashboard: function() {
                    const currentSite = Utils.getCurrentSite();
                    const filteredAssessments = Utils.filterByCurrentSite(db.assessments);
                    const filteredSpecies = Utils.filterByCurrentSite(db.species);
                    const filteredActivities = Utils.filterByCurrentSite(db.activities);
                    const filteredMonitoring = Utils.filterByCurrentSite(db.monitoring);

                    const upcomingTasks = filteredActivities.filter(a => a && a.status !== 'completed' && a.status !== 'cancelled');
                    
                    const totalTasks = document.getElementById('totalTasks');
                    const totalAssessments = document.getElementById('totalAssessments');
                    const totalSpecies = document.getElementById('totalSpecies');
                    
                    if (totalTasks) totalTasks.textContent = upcomingTasks.length;
                    if (totalAssessments) totalAssessments.textContent = filteredAssessments.length;
                    if (totalSpecies) totalSpecies.textContent = filteredSpecies.length;

                    const completedItems = db.complianceChecklist.filter(item => item && item.compliant === 'Yes').length;
                    const totalItems = db.complianceChecklist.length;
                    const progress = totalItems ? Math.round((completedItems / totalItems) * 100) : 0;
                    
                    const compliancePercent = document.getElementById('compliancePercent');
                    if (compliancePercent) compliancePercent.textContent = progress + '%';

                    const tasksList = document.getElementById('upcomingTasksList');
                    if (tasksList) {
                        tasksList.innerHTML = '';

                        if (upcomingTasks.length === 0) {
                            tasksList.innerHTML = '
                                <div class="empty-state">
                                    <i class="bi bi-check-circle"></i>
                                    <p>No upcoming tasks for this site</p>
                                </div>
                            ';
                        } else {
                            upcomingTasks
                                .sort((a, b) => new Date(a.startDate) - new Date(b.startDate))
                                .slice(0, 5)
                                .forEach(task => {
                                    if (!task) return;
                                    const item = document.createElement('a');
                                    item.href = '#';
                                    item.className = 'list-group-item list-group-item-action';
                                    item.setAttribute('role', 'listitem');
                                    item.innerHTML = '
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1">${Utils.sanitizeHTML(task.title)}</h6>
                                            <small class="text-muted">${Utils.formatDate(task.startDate)}</small>
                                        </div>
                                        <p class="mb-1">${Utils.sanitizeHTML(task.description ? task.description.substring(0, 50) : '')}${task.description && task.description.length > 50 ? '...' : ''}</p>
                                        <small class="text-muted">Assigned to: ${Utils.sanitizeHTML(task.assignedTo)}</small>
                                    ';
                                    item.addEventListener('click', (e) => {
                                        e.preventDefault();
                                        this.showActivityDetails(task);
                                    });
                                    tasksList.appendChild(item);
                                });
                        }
                    }

                    const observationsList = document.getElementById('recentObservationsList');
                    if (observationsList) {
                        observationsList.innerHTML = '';

                        const recent = filteredMonitoring
                            .filter(m => m && m.date)
                            .sort((a, b) => new Date(b.date) - new Date(a.date))
                            .slice(0, 4);

                        if (recent.length === 0) {
                            observationsList.innerHTML = '
                                <li class="list-group-item empty-state">
                                    <i class="bi bi-binoculars"></i>
                                    <p>No recent observations for this site</p>
                                </li>
                            ';
                        } else {
                            recent.forEach(obs => {
                                if (!obs) return;
                                const item = document.createElement('li');
                                item.className = 'list-group-item d-flex justify-content-between align-items-center';
                                item.setAttribute('role', 'listitem');
                                item.innerHTML = '
                                    ${obs.type === 'fauna-survey' ? 'Fauna sighting' : 'Vegetation survey'}
                                    <span class="badge ${obs.type === 'fauna-survey' ? 'bg-info' : 'bg-success'} rounded-pill">
                                        ${Utils.formatDate(obs.date)}
                                    </span>
                                ';
                                item.addEventListener('click', () => this.showMonitoringDetails(obs));
                                observationsList.appendChild(item);
                            });
                        }
                    }

                    const checklistDiv = document.getElementById('dashboardComplianceChecklist');
                    if (checklistDiv) {
                        checklistDiv.innerHTML = '';

                        const progressBar = document.getElementById('complianceProgress');
                        if (progressBar) {
                            progressBar.style.width = progress + '%';
                            progressBar.textContent = progress + '% Complete';
                            progressBar.setAttribute('aria-valuenow', progress);
                        }

                        db.complianceChecklist.forEach(item => {
                            if (!item) return;
                            const checkDiv = document.createElement('div');
                            checkDiv.className = 'form-check mb-2';
                            checkDiv.innerHTML = '
                                <input class="form-check-input" type="checkbox" 
                                       id="dashCheck${item.id}" ${item.compliant === 'Yes' ? 'checked' : ''} disabled>
                                <label class="form-check-label" for="dashCheck${item.id}">
                                    ${Utils.sanitizeHTML(item.requirement)}
                                </label>
                            ';
                            checklistDiv.appendChild(checkDiv);
                        });
                    }
                    
                    this.updateHealthChart();
                },

                // [Keep all the other methods - loadAssessments, loadSpecies, loadActivities, etc. - unchanged]
                // I'm truncating here for brevity, but you would keep all your existing methods

                setupEventListeners: function() {
                    // Existing event listeners...
                    
                    // CRITICAL: Tab change listener with map resize
                    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
                        tab.addEventListener('shown.bs.tab', (e) => {
                            const target = e.target.getAttribute('data-bs-target');
                            
                            if (target === '#dashboard') {
                                this.loadDashboard();
                                // Force map resize when switching to dashboard
                                setTimeout(() => {
                                    if (window.map) {
                                        window.map.invalidateSize();
                                        console.log('Map resized on dashboard tab switch');
                                        setTimeout(() => {
                                            if (window.map) {
                                                window.map.invalidateSize();
                                            }
                                        }, 200);
                                    }
                                }, 100);
                            } else if (target === '#site-assessment') {
                                this.loadAssessments();
                            } else if (target === '#maintenance-plan') {
                                this.loadActivities();
                                if (window.calendar) {
                                    setTimeout(() => window.calendar.updateSize(), 200);
                                }
                            } else if (target === '#species-register') {
                                this.loadSpecies();
                            } else if (target === '#monitoring') {
                                this.loadMonitoring();
                            } else if (target === '#reports') {
                                this.loadReports();
                            } else if (target === '#legislation') {
                                this.loadComplianceChecklist();
                            } else if (target === '#settings') {
                                this.loadSettings();
                            }
                        });
                    });
                }
            };

            // ==================== INITIALIZE APPLICATION ====================
            document.addEventListener('DOMContentLoaded', function() {
                App.init();
            });

            window.generateReport = function(type) {
                App.generateReport(type);
            };

        })();
    </script>
