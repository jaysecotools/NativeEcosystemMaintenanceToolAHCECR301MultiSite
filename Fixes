2. Fix the initMap function (around line 2220-2290) - add better container handling:

```javascript
initMap: function() {
    console.log('Starting map initialization...');
    
    const mapContainer = document.getElementById('map');
    if (!mapContainer) {
        console.error('Map container not found');
        return;
    }
    
    const site = Utils.getCurrentSite();
    if (!site) {
        mapContainer.innerHTML = '<div class="alert alert-warning">No site selected</div>';
        return;
    }
    
    let mapData = db.siteMaps[db.currentSiteId];
    if (!mapData) {
        mapData = Utils.generateSiteLocation(db.currentSiteId);
        db.siteMaps[db.currentSiteId] = mapData;
    }
    
    // Properly clean up existing map
    if (window.map) {
        try { 
            window.map.remove(); 
            window.map = null;
        } catch(e) {
            console.warn('Error removing map:', e);
        }
    }
    
    // Reset container
    mapContainer.style.height = '500px';
    mapContainer.style.minHeight = '500px';
    mapContainer.innerHTML = '';
    
    try {
        // Create map with explicit size
        window.map = L.map('map', {
            center: mapData.center,
            zoom: 13,
            zoomControl: true,
            fadeAnimation: true,
            attributionControl: true
        });
        
        // Add tile layer
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap',
            maxZoom: 19
        }).addTo(window.map);
        
        // Add site marker
        L.marker(mapData.center).bindPopup(`<b>${site.name}</b>`).addTo(window.map);
        
        // Create map layers
        this.createMapLayers(mapData);
        
        // Force a resize after a short delay
        setTimeout(() => {
            if (window.map) {
                window.map.invalidateSize(true);
                console.log('Map resized');
            }
        }, 300);
        
        // Initialize editing after map is ready
        setTimeout(() => {
            MapEditor.initEditing();
        }, 400);
        
        console.log('Map loaded successfully for site:', site.name);
        
    } catch(error) {
        console.error('Map error:', error);
        mapContainer.innerHTML = '<div class="alert alert-danger">Map failed to load: ' + error.message + '</div>';
    }
},
```

