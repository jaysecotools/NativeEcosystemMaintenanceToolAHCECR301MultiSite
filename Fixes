                populateSpeciesDropdown: function(selectId, selectedId) {
                    var select = document.getElementById(selectId);
                    if (!select) return;

                    select.innerHTML = '<option value="">None</option>';
                    
                    Utils.filterByCurrentSite(db.species).forEach(function(species) {
                        if (species) {
                            var option = document.createElement('option');
                            option.value = species.id;
                            option.textContent = species.scientificName + (species.commonName ? ' (' + species.commonName + ')' : '');
                            if (selectedId && species.id === selectedId) {
                                option.selected = true;
                            }
                            select.appendChild(option);
                        }
                    });
                },

                setupColorPicker: function(containerId, inputId, defaultColor) {
                    defaultColor = defaultColor || '#3498db';
                    
                    var container = document.getElementById(containerId);
                    var input = document.getElementById(inputId);
                    
                    if (!container || !input) return;

                    input.value = defaultColor;

                    container.querySelectorAll('.color-picker').forEach(function(picker) {
                        picker.classList.remove('selected');
                        if (picker.dataset.color === defaultColor) {
                            picker.classList.add('selected');
                        }

                        picker.addEventListener('click', function() {
                            container.querySelectorAll('.color-picker').forEach(function(p) { p.classList.remove('selected'); });
                            this.classList.add('selected');
                            input.value = this.dataset.color;
                        });
                    });
                },

                saveNewFeature: function() {
                    var form = document.getElementById('formAddMapFeature');
                    if (!form) return;
                    
                    if (!form.checkValidity()) {
                        form.classList.add('was-validated');
                        return;
                    }

                    try {
                        var category = document.getElementById('featureCategory').value;
                        var name = document.getElementById('featureName').value;
                        var description = document.getElementById('featureDescription').value;
                        var color = document.getElementById('featureColor').value;
                        var speciesId = document.getElementById('featureSpecies').value || null;
                        var featureType = document.getElementById('featureType').value;

                        var coordinates;
                        if (featureType === 'polygon' || featureType === 'line') {
                            coordinates = JSON.parse(document.getElementById('featureCoordinates').value);
                        } else {
                            var lat = parseFloat(document.getElementById('featureLat').value);
                            var lng = parseFloat(document.getElementById('featureLng').value);
                            coordinates = [lat, lng];
                        }

                        var feature = {
                            id: Utils.generateId(),
                            siteId: db.currentSiteId,
                            type: featureType,
                            category: category,
                            name: name,
                            description: description,
                            color: color,
                            speciesId: speciesId,
                            coordinates: coordinates,
                            createdAt: new Date().toISOString()
                        };

                        if (!db.mapFeatures[db.currentSiteId]) {
                            db.mapFeatures[db.currentSiteId] = { zones: [], vegetation: [], weeds: [], points: [] };
                        }

                        if (category === 'zone') {
                            db.mapFeatures[db.currentSiteId].zones.push(feature);
                        } else if (category === 'vegetation') {
                            db.mapFeatures[db.currentSiteId].vegetation.push(feature);
                        } else if (category === 'weed') {
                            db.mapFeatures[db.currentSiteId].weeds.push(feature);
                        } else {
                            db.mapFeatures[db.currentSiteId].points.push(feature);
                        }

                        var modal = document.getElementById('modalAddMapFeature');
                        if (modal && modal.currentLayer) {
                            modal.currentLayer.featureData = feature;
                            modal.currentLayer.unbindPopup();
                            modal.currentLayer.bindPopup(this.createFeaturePopup(feature));
                        }

                        if (Utils.saveData()) {
                            if (modal) bootstrap.Modal.getInstance(modal).hide();
                            Utils.showToast('Success', 'Feature added to map');
                            this.updateMapFeaturesCount();
                        }
                    } catch (e) {
                        console.error('Error saving feature:', e);
                        Utils.showToast('Error', 'Failed to save feature', 'error');
                    }
