                        if (reportType) reportType.classList.add('is-invalid');
                        return;
                    }

                    var startDate = document.getElementById('reportStartDate').value;
                    var endDate = document.getElementById('reportEndDate').value;
                    var format = document.getElementById('reportFormat').value;
                    var currentSite = Utils.getCurrentSite();

                    var reportTypes = {
                        'compliance': 'Compliance Report',
                        'maintenance': 'Maintenance Summary',
                        'monitoring': 'Monitoring Summary',
                        'health-trend': 'Ecosystem Health Trend',
                        'threat-management': 'Threat Management'
                    };

                    var data = [];
                    if (startDate && endDate) {
                        var start = new Date(startDate);
                        var end = new Date(endDate);
                        
                        if (type === 'maintenance') {
                            data = Utils.filterByCurrentSite(db.activities).filter(function(a) { return a && a.startDate && new Date(a.startDate) >= start && new Date(a.startDate) <= end; });
                        } else if (type === 'monitoring') {
                            data = Utils.filterByCurrentSite(db.monitoring).filter(function(m) { return m && m.date && new Date(m.date) >= start && new Date(m.date) <= end; });
                        } else if (type === 'health-trend') {
                            data = Utils.filterByCurrentSite(db.assessments).filter(function(a) { return a && a.date && new Date(a.date) >= start && new Date(a.date) <= end; });
                        }
                    } else {
                        data = type === 'maintenance' ? Utils.filterByCurrentSite(db.activities) :
                               type === 'monitoring' ? Utils.filterByCurrentSite(db.monitoring) :
                               type === 'health-trend' ? Utils.filterByCurrentSite(db.assessments) :
                               [];
                    }

                    var newReport = {
                        id: Utils.generateId(),
                        siteId: db.currentSiteId,
                        type: type,
                        date: new Date().toISOString(),
                        generatedBy: db.settings.userProfile.name,
                        period: startDate && endDate ? Utils.formatDate(startDate) + ' to ' + Utils.formatDate(endDate) : 'All time',
                        content: {
                            title: reportTypes[type],
                            body: 'Report generated for ' + (currentSite ? currentSite.name : 'site'),
                            data: data,
                            progress: type === 'compliance' ? 
                                Math.round((db.complianceChecklist.filter(function(item) { return item && item.compliant === 'Yes'; }).length / db.complianceChecklist.length) * 100) : null,
                            checklist: type === 'compliance' ? db.complianceChecklist : []
                        },
                        format: format,
                        createdAt: new Date().toISOString()
                    };

                    db.reports.push(newReport);
                    
                    if (Utils.saveData()) {
