I've examined your HTML file, and I can see the issue with the map display. The problem is that the map container has a height of 500px and the map is being initialized, but the container might not be properly sized when the map initializes, especially if the dashboard tab isn't active when the page loads.

Here are the key fixes I've identified:

1. The map container sizing issue - The map needs to be properly sized after it's initialized, especially when the dashboard tab might not be the active tab on load.
2. The tab activation issue - The map is being initialized immediately, but the dashboard tab might not be visible, causing sizing issues.

Here's the fix - replace your existing initMap function with this improved version:

```javascript
initMap: function() {
    console.log('Starting map initialization...');
    
    const mapContainer = document.getElementById('map');
    if (!mapContainer) {
        console.error('Map container not found');
        return;
    }
    
    const site = Utils.getCurrentSite();
    if (!site) {
        mapContainer.innerHTML = '<div class="alert alert-warning">No site selected</div>';
        return;
    }
    
    let mapData = db.siteMaps[db.currentSiteId];
    if (!mapData) {
        mapData = Utils.generateSiteLocation(db.currentSiteId);
        db.siteMaps[db.currentSiteId] = mapData;
    }
    
    // Clear existing map
    if (window.map) {
        try { window.map.remove(); } catch(e) {}
        window.map = null;
    }
    
    try {
        // Clear container - let CSS handle the sizing
        mapContainer.innerHTML = '';
        
        // Initialize map
        window.map = L.map('map', {
            center: mapData.center,
            zoom: 13,
            zoomControl: true
        });
        
        // Add tile layer
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(window.map);
        
        // CRITICAL FIX: Force size calculation with multiple attempts
        const forceResize = function(attempts) {
            attempts = attempts || 0;
            if (window.map) {
                window.map.invalidateSize();
                console.log('Map resized, attempt:', attempts);
            }
            // Try again if still not visible
            if (attempts < 3) {
                setTimeout(function() {
                    forceResize(attempts + 1);
                }, 100);
            }
        };
        
        // Initial resize after a short delay to ensure container is rendered
        setTimeout(function() {
            forceResize(0);
        }, 50);
        
        // Additional resize after any tab transitions
        setTimeout(function() {
            if (window.map) {
                window.map.invalidateSize();
                console.log('Map resized after tab transition');
            }
        }, 500);
        
        // Add site marker
        L.marker(mapData.center).bindPopup(`<b>${site.name}</b>`).addTo(window.map);
        
        // Create map layers
        this.createMapLayers(mapData);
        
        // Initialize editing
        setTimeout(() => {
            MapEditor.initEditing();
        }, 300);
        
        console.log('Map loaded successfully');
        
    } catch(error) {
        console.error('Map error:', error);
        mapContainer.innerHTML = '<div class="alert alert-danger">Map failed to load: ' + error.message + '</div>';
    }
}
```

