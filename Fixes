                },

                saveFaunaSighting: function() {
                    var form = document.getElementById('formFaunaSighting');
                    if (!form) return;
                    
                    if (!form.checkValidity()) {
                        form.classList.add('was-validated');
                        return;
                    }

                    var newSighting = {
                        id: Utils.generateId(),
                        siteId: db.currentSiteId,
                        speciesId: parseInt(document.getElementById('faunaSpecies').value),
                        date: document.getElementById('faunaDate').value,
                        location: document.getElementById('faunaLocation').value,
                        observer: document.getElementById('faunaObserver').value,
                        count: parseInt(document.getElementById('faunaCount').value) || 1,
                        behavior: document.getElementById('faunaBehavior').value,
                        photos: [],
                        notes: document.getElementById('faunaNotes').value,
                        createdAt: new Date().toISOString()
                    };

                    db.faunaSightings.push(newSighting);

                    var species = db.species.find(function(s) { return s && s.id === newSighting.speciesId; });
                    if (species) {
                        species.lastObserved = newSighting.date;
                    }

                    if (Utils.saveData()) {
                        form.reset();
                        form.classList.remove('was-validated');
                        var preview = document.getElementById('faunaPhotoPreview');
                        if (preview) preview.innerHTML = '';
                        
                        bootstrap.Modal.getInstance(document.getElementById('modalFaunaSighting')).hide();
                        Utils.showToast('Success', 'Fauna sighting saved');
                        
                        this.loadSpecies();
                    }
                },

                saveVegetationSurvey: function() {
                    var form = document.getElementById('formVegetationSurvey');
                    if (!form) return;
                    
                    if (!form.checkValidity()) {
                        form.classList.add('was-validated');
                        return;
                    }

                    var speciesSelect = document.getElementById('vegetationSpecies');
                    var species = speciesSelect ? Array.from(speciesSelect.selectedOptions).map(function(opt) { return parseInt(opt.value); }) : [];

                    var newSurvey = {
                        id: Utils.generateId(),
                        siteId: db.currentSiteId,
                        date: document.getElementById('vegetationDate').value,
                        location: document.getElementById('vegetationLocation').value,
                        observer: document.getElementById('vegetationObserver').value,
                        species: species,
                        nativeCover: parseInt(document.getElementById('vegetationCover').value) || 0,
                        weedCover: parseInt(document.getElementById('vegetationWeedCover').value) || 0,
                        health: document.getElementById('vegetationHealth').value,
                        findings: document.getElementById('vegetationFindings').value,
                        photos: [],
                        notes: document.getElementById('vegetationNotes').value,
                        createdAt: new Date().toISOString()
                    };

                    db.vegetationSurveys.push(newSurvey);

                    species.forEach(function(id) {
                        var s = db.species.find(function(sp) { return sp && sp.id === id; });
                        if (s) s.lastObserved = newSurvey.date;
                    });

                    if (Utils.saveData()) {
                        form.reset();
                        form.classList.remove('was-validated');
                        var preview = document.getElementById('vegetationPhotoPreview');
                        if (preview) preview.innerHTML = '';
                        
                        bootstrap.Modal.getInstance(document.getElementById('modalVegetationSurvey')).hide();
                        Utils.showToast('Success', 'Vegetation survey saved');
                        
                        this.loadSpecies();
                    }
                },

                setupEventListeners: function() {
                    var siteSelector = document.getElementById('siteSelector');
                    if (siteSelector) {
                        siteSelector.addEventListener('change', function(e) {
                            var siteId = parseInt(e.target.value);
                            if (siteId && siteId !== db.currentSiteId) {
                                var site = db.sites.find(function(s) { return s && s.id === siteId; });
                                if (site) {
                                    SiteManager.promptSwitchSite(siteId, site.name);
                                }
                            }
                        });
                    }

                    var confirmSwitchBtn = document.getElementById('confirmSwitchSiteBtn');
                    if (confirmSwitchBtn) {
                        confirmSwitchBtn.addEventListener('click', function() {
                            var siteId = parseInt(document.getElementById('switchTargetSiteId').value);
                            SiteManager.switchSite(siteId);
                        });
                    }

                    var saveSiteBtn = document.getElementById('saveSiteBtn');
                    if (saveSiteBtn) saveSiteBtn.addEventListener('click', function() { SiteManager.saveSite(); });
                    
                    var updateSiteBtn = document.getElementById('updateSiteBtn');
                    if (updateSiteBtn) updateSiteBtn.addEventListener('click', function() { SiteManager.updateSite(); });
                    
                    var saveAssessmentBtn = document.getElementById('saveAssessmentBtn');
                    if (saveAssessmentBtn) saveAssessmentBtn.addEventListener('click', function() { App.saveAssessment(); });
                    
                    var saveActivityBtn = document.getElementById('saveActivityBtn');
                    if (saveActivityBtn) saveActivityBtn.addEventListener('click', function() { App.saveActivity(); });
                    
                    var saveSpeciesBtn = document.getElementById('saveSpeciesBtn');
                    if (saveSpeciesBtn) saveSpeciesBtn.addEventListener('click', function() { App.saveSpecies(); });
                    
                    var saveMonitoringBtn = document.getElementById('saveMonitoringBtn');
                    if (saveMonitoringBtn) saveMonitoringBtn.addEventListener('click', function() { App.saveMonitoring(); });
                    
                    var saveFaunaSightingBtn = document.getElementById('saveFaunaSightingBtn');
                    if (saveFaunaSightingBtn) saveFaunaSightingBtn.addEventListener('click', function() { App.saveFaunaSighting(); });
                    
                    var saveVegetationSurveyBtn = document.getElementById('saveVegetationSurveyBtn');
                    if (saveVegetationSurveyBtn) saveVegetationSurveyBtn.addEventListener('click', function() { App.saveVegetationSurvey(); });
                    
                    var saveComplianceBtn = document.getElementById('saveComplianceBtn');
                    if (saveComplianceBtn) saveComplianceBtn.addEventListener('click', function() { App.saveComplianceChecklist(); });
                    
                    var generateReportBtn = document.getElementById('generateReportBtn');
                    if (generateReportBtn) generateReportBtn.addEventListener('click', function() { App.generateReportFromModal(); });

                    document.querySelectorAll('.generate-report-btn').forEach(function(btn) {
                        btn.addEventListener('click', function(e) {
                            var type = e.target.dataset.type;
                            App.generateReport(type);
                        });
                    });

                    var settingsUserProfileForm = document.getElementById('settingsUserProfileForm');
                    if (settingsUserProfileForm) {
                        settingsUserProfileForm.addEventListener('submit', function(e) { App.saveUserProfile(e); });
                    }
                    
                    var settingsPasswordForm = document.getElementById('settingsPasswordForm');
                    if (settingsPasswordForm) {
                        settingsPasswordForm.addEventListener('submit', function(e) { App.changePassword(e); });
                    }

                    var exportAllDataBtn = document.getElementById('exportAllDataBtn');
                    if (exportAllDataBtn) exportAllDataBtn.addEventListener('click', function() { App.exportAllData(); });
                    
                    var backupDatabaseBtn = document.getElementById('backupDatabaseBtn');
                    if (backupDatabaseBtn) backupDatabaseBtn.addEventListener('click', function() { App.backupDatabase(); });
                    
                    var resetTestDataBtn = document.getElementById('resetTestDataBtn');
                    if (resetTestDataBtn) resetTestDataBtn.addEventListener('click', function() { App.resetTestData(); });

                    var exportDashboardBtn = document.getElementById('exportDashboardBtn');
                    if (exportDashboardBtn) exportDashboardBtn.addEventListener('click', function() { App.exportAllData(); });
                    
                    var printDashboardBtn = document.getElementById('printDashboardBtn');
                    if (printDashboardBtn) printDashboardBtn.addEventListener('click', function() { window.print(); });
                    
                    var exportSpeciesBtn = document.getElementById('exportSpeciesBtn');
                    if (exportSpeciesBtn) exportSpeciesBtn.addEventListener('click', function() { App.exportAllData(); });
                    
                    var printSpeciesBtn = document.getElementById('printSpeciesBtn');
                    if (printSpeciesBtn) printSpeciesBtn.addEventListener('click', function() { window.print(); });

                    var viewAllFaunaBtn = document.getElementById('viewAllFaunaBtn');
                    if (viewAllFaunaBtn) {
                        viewAllFaunaBtn.addEventListener('click', function() {
                            var monitoringTab = document.querySelector('button[data-bs-target="#monitoring"]');
                            if (monitoringTab) monitoringTab.click();
                        });
                    }
                    
                    var viewAllVegetationBtn = document.getElementById('viewAllVegetationBtn');
                    if (viewAllVegetationBtn) {
                        viewAllVegetationBtn.addEventListener('click', function() {
                            var monitoringTab = document.querySelector('button[data-bs-target="#monitoring"]');
                            if (monitoringTab) monitoringTab.click();
                        });
                    }

                    var printAssessmentBtn = document.getElementById('printAssessmentBtn');
                    if (printAssessmentBtn) printAssessmentBtn.addEventListener('click', function() { window.print(); });
                    
                    var printSpeciesDetailsBtn = document.getElementById('printSpeciesDetailsBtn');
                    if (printSpeciesDetailsBtn) printSpeciesDetailsBtn.addEventListener('click', function() { window.print(); });
                    
                    var printActivityBtn = document.getElementById('printActivityBtn');
                    if (printActivityBtn) printActivityBtn.addEventListener('click', function() { window.print(); });
                    
                    var printMonitoringBtn = document.getElementById('printMonitoringBtn');
                    if (printMonitoringBtn) printMonitoringBtn.addEventListener('click', function() { window.print(); });

                    var generateComplianceReportBtn = document.getElementById('generateComplianceReportBtn');
                    if (generateComplianceReportBtn) {
                        generateComplianceReportBtn.addEventListener('click', function() { App.generateReport('compliance'); });
                    }

                    var editModeBtn = document.getElementById('editModeBtn');
                    if (editModeBtn) {
                        editModeBtn.addEventListener('click', function() { MapEditor.toggleEditMode(); });
                    }

                    var saveMapBtn = document.getElementById('saveMapBtn');
                    if (saveMapBtn) {
                        saveMapBtn.addEventListener('click', function() { MapEditor.saveMap(); });
                    }

                    var clearMapBtn = document.getElementById('clearMapBtn');
                    if (clearMapBtn) {
                        clearMapBtn.addEventListener('click', function() { MapEditor.clearMap(); });
                    }

                    var saveMapFeatureBtn = document.getElementById('saveMapFeatureBtn');
                    if (saveMapFeatureBtn) {
                        saveMapFeatureBtn.addEventListener('click', function() { MapEditor.saveNewFeature(); });
                    }

                    var updateMapFeatureBtn = document.getElementById('updateMapFeatureBtn');
                    if (updateMapFeatureBtn) {
                        updateMapFeatureBtn.addEventListener('click', function() { MapEditor.updateFeature(); });
                    }

                    var deleteMapFeatureBtn = document.getElementById('deleteMapFeatureBtn');
                    if (deleteMapFeatureBtn) {
                        deleteMapFeatureBtn.addEventListener('click', function() { MapEditor.deleteFeature(); });
                    }

                    var importDataBtn = document.getElementById('importDataBtn');
                    if (importDataBtn) {
                        importDataBtn.addEventListener('click', function() { App.importDataFromFile(); });
                    }

                    document.addEventListener('click', function(e) {
                        if (e.target.closest('.edit-feature')) {
                            var featureId = parseInt(e.target.closest('.edit-feature').dataset.id);
                            MapEditor.showEditFeatureModal(featureId);
                        }
                    });

                    // Fixed tab event listeners
                    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(tab) {
                        tab.addEventListener('shown.bs.tab', function(e) {
                            var target = e.target.getAttribute('data-bs-target');
                            
                            if (target === '#dashboard') {
                                App.loadDashboard();
                                // CRITICAL: Fix map when switching to dashboard tab
                                setTimeout(function() {
                                    if (window.map) {
                                        window.map.invalidateSize(true);
                                    } else {
                                        App.initMap();
                                    }
                                }, 400);
                            } else if (target === '#site-assessment') {
                                App.loadAssessments();
                            } else if (target === '#maintenance-plan') {
                                App.loadActivities();
                                if (window.calendar) {
                                    setTimeout(function() { window.calendar.updateSize(); }, 200);
                                }
                            } else if (target === '#species-register') {
                                App.loadSpecies();
                            } else if (target === '#monitoring') {
                                App.loadMonitoring();
                            } else if (target === '#reports') {
                                App.loadReports();
                            } else if (target === '#legislation') {
                                App.loadComplianceChecklist();
                            } else if (target === '#settings') {
                                App.loadSettings();
                            }
                        });
                    });

                    var zoneToggle = document.getElementById('zoneToggle');
                    if (zoneToggle) {
                        zoneToggle.addEventListener('click', function() {
                            if (window.map) {
                                if (window.zonesLayer && window.map.hasLayer(window.zonesLayer)) {
                                    window.map.removeLayer(window.zonesLayer);
                                    if (window.customZonesLayer) window.map.removeLayer(window.customZonesLayer);
                                    this.classList.remove('active');
                                    this.setAttribute('aria-pressed', 'false');
                                } else {
                                    if (window.zonesLayer) window.map.addLayer(window.zonesLayer);
                                    if (window.customZonesLayer) window.map.addLayer(window.customZonesLayer);
                                    this.classList.add('active');
                                    this.setAttribute('aria-pressed', 'true');
                                }
                            }
                        });
                    }

                    var vegetationToggle = document.getElementById('vegetationToggle');
                    if (vegetationToggle) {
                        vegetationToggle.addEventListener('click', function() {
                            if (window.map) {
                                if (window.vegetationLayer && window.map.hasLayer(window.vegetationLayer)) {
                                    window.map.removeLayer(window.vegetationLayer);
                                    if (window.customVegetationLayer) window.map.removeLayer(window.customVegetationLayer);
                                    this.classList.remove('active');
                                    this.setAttribute('aria-pressed', 'false');
                                } else {
                                    if (window.vegetationLayer) window.map.addLayer(window.vegetationLayer);
                                    if (window.customVegetationLayer) window.map.addLayer(window.customVegetationLayer);
                                    this.classList.add('active');
                                    this.setAttribute('aria-pressed', 'true');
                                }
                            }
                        });
                    }

                    var weedsToggle = document.getElementById('weedsToggle');
                    if (weedsToggle) {
                        weedsToggle.addEventListener('click', function() {
                            if (window.map) {
                                if (window.weedsLayer && window.map.hasLayer(window.weedsLayer)) {
                                    window.map.removeLayer(window.weedsLayer);
                                    if (window.customWeedsLayer) window.map.removeLayer(window.customWeedsLayer);
                                    this.classList.remove('active');
                                    this.setAttribute('aria-pressed', 'false');
                                } else {
                                    if (window.weedsLayer) window.map.addLayer(window.weedsLayer);
                                    if (window.customWeedsLayer) window.map.addLayer(window.customWeedsLayer);
                                    this.classList.add('active');
                                    this.setAttribute('aria-pressed', 'true');
                                }
                            }
                        });
                    }

                    var speciesImage = document.getElementById('speciesImage');
                    if (speciesImage) {
                        speciesImage.addEventListener('change', function(e) {
                            var preview = document.getElementById('speciesImagePreview');
                            if (this.files && this.files[0] && preview) {
                                var url = URL.createObjectURL(this.files[0]);
                                preview.src = url;
                                preview.style.display = 'block';
                                
                                var modal = document.getElementById('modalNewSpecies');
                                modal.addEventListener('hidden.bs.modal', function() {
                                    URL.revokeObjectURL(url);
                                    preview.style.display = 'none';
                                }, { once: true });
                            }
                        });
                    }

                    ['assessment', 'monitoring', 'fauna', 'vegetation'].forEach(function(prefix) {
                        var input = document.getElementById(prefix + 'Photos');
                        var container = document.getElementById(prefix + 'PhotoPreview');
                        
                        if (input && container) {
                            input.addEventListener('change', function() {
                                container.innerHTML = '';
                                
                                if (this.files) {
                                    Array.from(this.files).forEach(function(file) {
                                        if (file.type.startsWith('image/')) {
                                            var url = URL.createObjectURL(file);
                                            var img = document.createElement('img');
                                            img.src = url;
                                            img.className = 'image-thumbnail';
                                            img.alt = 'Preview';
                                            container.appendChild(img);
                                            
                                            var modal = this.closest('.modal');
                                            if (modal) {
                                                modal.addEventListener('hidden.bs.modal', function() {
                                                    URL.revokeObjectURL(url);
                                                }, { once: true });
                                            }
                                        }
                                    }.bind(this));
                                }
                            });
                        }
                    });

                    document.querySelectorAll('#formNewAssessment input[name="components"]').forEach(function(cb) {
                        cb.addEventListener('change', function() {
                            var checked = document.querySelectorAll('#formNewAssessment input[name="components"]:checked');
                            var feedback = document.getElementById('componentsFeedback');
                            if (feedback) {
                                feedback.style.display = checked.length === 0 ? 'block' : 'none';
                            }
                        });
                    });

                    document.querySelectorAll('.modal').forEach(function(modal) {
                        modal.addEventListener('hidden.bs.modal', function() {
                            var form = this.querySelector('form');
                            if (form) {
                                form.reset();
                                form.classList.remove('was-validated');
                            }
                            
                            this.querySelectorAll('.image-preview-container').forEach(function(container) {
                                container.innerHTML = '';
                            });
                            
                            var speciesPreview = this.querySelector('#speciesImagePreview');
                            if (speciesPreview) {
                                speciesPreview.style.display = 'none';
                                speciesPreview.src = '#';
                            }
                            
                            var feedback = this.querySelector('#componentsFeedback');
                            if (feedback) {
                                feedback.style.display = 'none';
                            }
                        });
                    });
                }
            };

            // ==================== INITIALIZE APPLICATION ====================
            document.addEventListener('DOMContentLoaded', function() {
                App.init();
                
                // Emergency map loader - runs after everything
                setTimeout(function() {
                    console.log('Running emergency map check...');
                    var container = document.getElementById('map');
                    if (container && !container.querySelector('.leaflet-container')) {
                        console.log('Map not loaded, forcing initialization...');
                        App.initMap();
                    }
                }, 3000);
                
                // Window resize handler for map
                window.addEventListener('resize', function() {
                    if (window.map) {
                        setTimeout(function() {
                            window.map.invalidateSize(true);
                        }, 200);
                    }
                });
            });

            window.generateReport = function(type) {
                App.generateReport(type);
            };

        })();
    </script>
