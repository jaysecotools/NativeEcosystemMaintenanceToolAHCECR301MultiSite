                initMap: function() {
                    console.log('Starting map initialization...');
                    
                    var mapContainer = document.getElementById('map');
                    
                    if (!mapContainer) {
                        console.warn('Map container not found, will retry...');
                        setTimeout(function() { App.initMap(); }, 500);
                        return;
                    }
                    
                    // Force the container to be visible and have proper size
                    mapContainer.style.display = 'block';
                    mapContainer.style.height = '500px';
                    mapContainer.style.minHeight = '500px';
                    mapContainer.style.width = '100%';
                    mapContainer.innerHTML = '';
                    
                    // Give the DOM time to render
                    setTimeout(function() {
                        var site = Utils.getCurrentSite();
                        if (!site) {
                            mapContainer.innerHTML = '<div class="alert alert-warning">No site selected</div>';
                            return;
                        }
                        
                        var mapData = db.siteMaps[db.currentSiteId];
                        if (!mapData) {
                            mapData = Utils.generateSiteLocation(db.currentSiteId);
                            db.siteMaps[db.currentSiteId] = mapData;
                        }
                        
                        if (window.map) {
                            try { 
                                window.map.remove(); 
                                window.map = null;
                            } catch(e) {
                                console.warn('Error removing map:', e);
                            }
                        }
                        
                        try {
                            if (typeof L === 'undefined') {
                                console.error('Leaflet not loaded');
                                mapContainer.innerHTML = '<div class="alert alert-danger">Leaflet library not loaded. Please check your internet connection.</div>';
                                return;
                            }
                            
                            if (!document.body.contains(mapContainer)) {
                                console.error('Map container is not in the DOM');
                                return;
                            }
                            
                            // Create the map with explicit options
                            window.map = L.map('map', {
                                center: mapData.center,
                                zoom: 13,
                                zoomControl: true,
                                fadeAnimation: true,
                                attributionControl: true
                            });
                            
                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                attribution: '&copy; OpenStreetMap',
                                maxZoom: 19
                            }).addTo(window.map);
                            
                            L.marker(mapData.center).bindPopup('<b>' + site.name + '</b>').addTo(window.map);
                            
                            this.createMapLayers(mapData);
                            
                            // Force resize after map is created
                            setTimeout(function() {
                                if (window.map) {
                                    window.map.invalidateSize(true);
                                    console.log('Map resized successfully');
                                }
                            }, 300);
                            
                            // Load custom features and initialize editing after map is ready
                            setTimeout(function() {
                                MapEditor.loadFeaturesForCurrentSite();
                                MapEditor.initEditing();
                                console.log('Map editing initialized');
                            }, 500);
                            
                            console.log('Map loaded successfully for site:', site.name);
                            
                        } catch(error) {
                            console.error('Map error:', error);
                            mapContainer.innerHTML = '<div class="alert alert-danger">Map failed to load: ' + error.message + '</div>';
                        }
                    }, 100);
                },

                createMapLayers: function(mapData) {
                    if (!mapData) return;
                    
                    if (window.zonesLayer) window.zonesLayer.clearLayers();
                    if (window.vegetationLayer) window.vegetationLayer.clearLayers();
                    if (window.weedsLayer) window.weedsLayer.clearLayers();
                    
                    window.zonesLayer = L.layerGroup();
                    window.vegetationLayer = L.layerGroup();
                    window.weedsLayer = L.layerGroup();
                    
                    if (mapData.zones) {
                        mapData.zones.forEach(function(zone) {
                            if (zone && zone.coords) {
                                try {
                                    var polygon = L.polygon(zone.coords, {
                                        color: zone.color,
                                        weight: 2,
                                        opacity: 0.8,
                                        fillOpacity: 0.2
                                    }).bindPopup('<b>' + zone.name + '</b>');
                                    window.zonesLayer.addLayer(polygon);
                                } catch (e) {
                                    console.error('Error creating zone polygon:', e);
                                }
                            }
                        });
                    }
                    
                    if (mapData.vegetationMarkers) {
                        mapData.vegetationMarkers.forEach(function(markerData) {
                            if (markerData && markerData.coords) {
                                try {
                                    var marker = L.circleMarker(markerData.coords, {
                                        radius: 8,
                                        color: '#27ae60',
                                        fillColor: '#27ae60',
                                        fillOpacity: 0.8
                                    }).bindPopup('<b>Vegetation:</b> ' + markerData.name);
                                    window.vegetationLayer.addLayer(marker);
                                } catch (e) {
                                    console.error('Error creating vegetation marker:', e);
                                }
                            }
                        });
                    }
                    
                    if (mapData.weedMarkers) {
                        mapData.weedMarkers.forEach(function(markerData) {
                            if (markerData && markerData.coords) {
                                try {
                                    var marker = L.circleMarker(markerData.coords, {
                                        radius: 8,
                                        color: '#e74c3c',
                                        fillColor: '#e74c3c',
                                        fillOpacity: 0.8
                                    }).bindPopup('<b>Weed:</b> ' + markerData.name);
                                    window.weedsLayer.addLayer(marker);
                                } catch (e) {
                                    console.error('Error creating weed marker:', e);
                                }
                            }
                        });
                    }

                    window.zonesLayer.addTo(window.map);
                    
                    var zoneToggle = document.getElementById('zoneToggle');
                    var vegToggle = document.getElementById('vegetationToggle');
                    var weedsToggle = document.getElementById('weedsToggle');
                    
                    if (zoneToggle) {
                        zoneToggle.classList.add('active');
                        zoneToggle.setAttribute('aria-pressed', 'true');
                    }
                    if (vegToggle) {
                        vegToggle.classList.remove('active');
                        vegToggle.setAttribute('aria-pressed', 'false');
                    }
                    if (weedsToggle) {
                        weedsToggle.classList.remove('active');
                        weedsToggle.setAttribute('aria-pressed', 'false');
                    }
                },

