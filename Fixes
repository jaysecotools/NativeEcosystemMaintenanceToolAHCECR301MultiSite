                showMapConfigModal: function(siteId, siteName) {
                    var mapData = db.siteMaps[siteId] || Utils.generateSiteLocation(siteId);
                    
                    var lat = prompt('Enter latitude for ' + siteName + ':', mapData.center[0]);
                    if (lat !== null) {
                        var lng = prompt('Enter longitude for ' + siteName + ':', mapData.center[1]);
                        if (lng !== null) {
                            mapData.center = [parseFloat(lat) || mapData.center[0], parseFloat(lng) || mapData.center[1]];
                            db.siteMaps[siteId] = mapData;
                            Utils.saveData();
                            Utils.showToast('Success', 'Map location updated for ' + siteName);
                            
                            if (siteId === db.currentSiteId && window.map) {
                                App.updateMapForCurrentSite();
                            }
                        }
                    }
                },

                showEditSiteModal: function(site) {
                    var editSiteId = document.getElementById('editSiteId');
                    var editSiteName = document.getElementById('editSiteName');
                    var editSiteLocation = document.getElementById('editSiteLocation');
                    var editSiteArea = document.getElementById('editSiteArea');
                    var editSiteDescription = document.getElementById('editSiteDescription');
                    
                    if (editSiteId) editSiteId.value = site.id;
                    if (editSiteName) editSiteName.value = site.name;
                    if (editSiteLocation) editSiteLocation.value = site.location;
                    if (editSiteArea) editSiteArea.value = site.area;
                    if (editSiteDescription) editSiteDescription.value = site.description;
                    
                    new bootstrap.Modal(document.getElementById('modalEditSite')).show();
                },

                updateSite: function() {
                    var form = document.getElementById('formEditSite');
                    if (!form) return;
                    
                    if (!form.checkValidity()) {
                        form.classList.add('was-validated');
                        return;
                    }
                    
                    var id = parseInt(document.getElementById('editSiteId').value);
                    var site = db.sites.find(function(s) { return s && s.id === id; });
                    
                    if (site) {
                        site.name = document.getElementById('editSiteName').value;
                        site.location = document.getElementById('editSiteLocation').value;
                        site.area = parseFloat(document.getElementById('editSiteArea').value);
                        site.description = document.getElementById('editSiteDescription').value;
                        
                        if (Utils.saveData()) {
                            form.reset();
                            form.classList.remove('was-validated');
                            bootstrap.Modal.getInstance(document.getElementById('modalEditSite')).hide();
                            Utils.showToast('Success', 'Site updated successfully');
                            
                            this.loadSiteSelector();
                            
                            if (id === db.currentSiteId) {
                                App.loadAllData();
                            }
                        }
                    }
                },

                saveSite: function() {
                    var form = document.getElementById('formNewSite');
                    if (!form) return;
                    
                    if (!form.checkValidity()) {
                        form.classList.add('was-validated');
                        return;
                    }
                    
                    var newSite = {
                        id: Utils.generateId(),
                        name: document.getElementById('siteName').value,
                        location: document.getElementById('siteLocation').value,
                        area: parseFloat(document.getElementById('siteArea').value),
                        description: document.getElementById('siteDescription').value,
                        createdAt: new Date().toISOString()
                    };
                    
                    db.sites.push(newSite);
                    db.siteMaps[newSite.id] = Utils.generateSiteLocation(newSite.id);
                    db.mapFeatures[newSite.id] = { zones: [], vegetation: [], weeds: [], points: [] };
                    
                    if (Utils.saveData()) {
                        form.reset();
                        form.classList.remove('was-validated');
                        bootstrap.Modal.getInstance(document.getElementById('modalNewSite')).hide();
                        Utils.showToast('Success', 'Site created successfully');
                        
                        this.loadSiteSelector();
                        
                        if (db.sites.length === 1) {
                            db.currentSiteId = newSite.id;
                            this.loadSiteSelector();
                            App.loadAllData();
                        }
                    }
                },

                confirmDeleteSite: function(siteId, siteName) {
                    Utils.showConfirmation(
                        'Delete Site',
                        'Are you sure you want to delete "' + siteName + '"? This will permanently delete all data associated with this site.',
                        function() { SiteManager.deleteSite(siteId); }
                    );
                },

                deleteSite: function(siteId) {
                    db.sites = db.sites.filter(function(s) { return s && s.id !== siteId; });
                    delete db.siteMaps[siteId];
                    delete db.mapFeatures[siteId];
                    
                    db.assessments = db.assessments.filter(function(a) { return a && a.siteId !== siteId; });
                    db.species = db.species.filter(function(s) { return s && s.siteId !== siteId; });
                    db.activities = db.activities.filter(function(a) { return a && a.siteId !== siteId; });
                    db.monitoring = db.monitoring.filter(function(m) { return m && m.siteId !== siteId; });
                    db.reports = db.reports.filter(function(r) { return r && r.siteId !== siteId; });
                    db.faunaSightings = db.faunaSightings.filter(function(f) { return f && f.siteId !== siteId; });
                    db.vegetationSurveys = db.vegetationSurveys.filter(function(v) { return v && v.siteId !== siteId; });
                    
                    if (db.currentSiteId === siteId) {
                        db.currentSiteId = db.sites.length > 0 ? db.sites[0].id : null;
                    }
                    
                    if (Utils.saveData()) {
                        Utils.showToast('Success', 'Site deleted successfully');
                        this.loadSiteSelector();
                        App.loadAllData();
                    }
                },

                promptSwitchSite: function(siteId, siteName) {
                    var switchTargetId = document.getElementById('switchTargetSiteId');
                    var switchTargetName = document.getElementById('switchTargetSiteName');
                    
                    if (switchTargetId) switchTargetId.value = siteId;
                    if (switchTargetName) switchTargetName.textContent = siteName;
                    
                    new bootstrap.Modal(document.getElementById('modalSwitchSite')).show();
                },

                switchSite: function(siteId) {
                    Utils.saveData();
                    db.currentSiteId = siteId;
                    this.loadSiteSelector();
                    App.populateModalSiteIds();
                    
                    setTimeout(function() {
                        App.updateHealthChart();
                    }, 100);
                    
                    setTimeout(function() {
                        App.loadAllData();
                    }, 200);
                    
                    setTimeout(function() {
                        if (window.map) {
                            try { 
                                window.map.remove(); 
                                window.map = null;
                            } catch(e) {}
                        }
                        App.initMap();
                    }, 400);
                    
                    bootstrap.Modal.getInstance(document.getElementById('modalSwitchSite')).hide();
                    
                    var site = db.sites.find(function(s) { return s && s.id === siteId; });
                    Utils.showToast('Success', 'Switched to ' + (site ? site.name : 'site'));
                }
            };

