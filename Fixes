                        if (format === 'pdf') {
                            this.generatePDFReport(newReport);
                        } else if (format === 'excel') {
                            this.generateExcelReport(newReport);
                        } else {
                            this.generateWordReport(newReport);
                        }
                        
                        Utils.showToast('Success', reportTypes[type] + ' generated successfully!');
                        this.loadReports();
                    }
