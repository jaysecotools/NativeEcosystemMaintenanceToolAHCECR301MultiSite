Step 2: Update the MapEditor.initEditing Function

Find the initEditing: function() in the MapEditor object (around line 1670). Replace it with:

```javascript
initEditing: function() {
    if (!window.map) {
        console.error('Map not initialized');
        return;
    }

    // Wait for map to be fully ready
    setTimeout(function() {
        if (window.map.pm) {
            try {
                // Clear any existing controls first
                if (window.map.pm.getControls()) {
                    window.map.pm.removeControls();
                }
                
                window.map.pm.addControls({
                    position: 'topleft',
                    drawMarker: true,
                    drawPolygon: true,
                    drawPolyline: true,
                    drawCircle: true,
                    drawRectangle: true,
                    editMode: true,
                    dragMode: true,
                    cutPolygon: true,
                    removalMode: true
                });

                window.map.pm.setLang('en');
                window.map.pm.setGlobalOptions({
                    snappable: false,
                    allowSelfIntersection: false
                });

                // Only add event listeners once
                if (!window._pmEventsAdded) {
                    window.map.on('pm:create', function(e) {
                        MapEditor.onFeatureCreated(e);
                    });

                    window.map.on('pm:edit', function(e) {
                        MapEditor.onFeatureEdited(e);
                    });

                    window.map.on('pm:remove', function(e) {
                        MapEditor.onFeatureRemoved(e);
                    });
                    window._pmEventsAdded = true;
                }
                
                console.log('Map editing controls added');
            } catch (e) {
                console.error('Error initializing map editing:', e);
            }
        } else {
            console.warn('Leaflet Geoman not available - map editing disabled');
        }
    }, 300);

    this.loadFeaturesForCurrentSite();
    console.log('Map editing initialized');
},
```

Step 3: Add a Window Resize Handler

Add this code at the bottom of your JavaScript, just before the closing })();:

```javascript
// Add window resize handler to fix map on tab switches
window.addEventListener('resize', function() {
    if (window.map) {
        setTimeout(function() {
            window.map.invalidateSize(true);
        }, 200);
    }
});

// Fix map when switching tabs
document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(tab) {
    tab.addEventListener('shown.bs.tab', function(e) {
        var target = e.target.getAttribute('data-bs-target');
        if (target === '#dashboard' || target === '#site-assessment') {
            setTimeout(function() {
                if (window.map) {
                    window.map.invalidateSize(true);
                }
            }, 400);
        }
    });
});
```

Why This Works

1. Proper Timing: The map now waits for the DOM to render before initializing
2. Container Sizing: Forces the map container to have explicit dimensions
3. Incremental Loading: Loads the map, then layers, then editing tools in sequence with delays
4. Tab Switching: Automatically resizes the map when you switch between tabs
5. Event Cleanup: Prevents duplicate event listeners from being added

Testing Instructions

1. Save your file and refresh the page
2. The map should now appear in the Dashboard tab
3. Click on other tabs and click back to Dashboard - map should still work
4. Click "Edit Mode" - drawing tools should appear
5. Try drawing a polygon - the feature modal should appear

