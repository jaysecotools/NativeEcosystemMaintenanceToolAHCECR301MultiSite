    }
    
    if (window.map) {
        try { window.map.remove(); } catch(e) {}
        window.map = null;
    }
    
    try {
        mapContainer.innerHTML = '';
        
        window.map = L.map('map', {
            center: mapData.center,
            zoom: 13,
            zoomControl: true
        });
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
