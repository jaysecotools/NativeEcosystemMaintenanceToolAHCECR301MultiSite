                initCalendar: function() {
                    console.log('initCalendar called');
                    var calendarEl = document.getElementById('calendar');
                    if (!calendarEl || typeof FullCalendar === 'undefined') return;
                    
                    if (window.calendar) {
                        try { window.calendar.destroy(); } catch(e) {}
                    }

                    window.calendar = new FullCalendar.Calendar(calendarEl, {
                        initialView: 'dayGridMonth',
                        headerToolbar: {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'dayGridMonth'
                        },
                        events: [],
                        height: 600
                    });

                    window.calendar.render();
                },

                setupEventListeners: function() {
                    console.log('setupEventListeners called');
                    
                    // Site selector
                    var siteSelector = document.getElementById('siteSelector');
                    if (siteSelector) {
                        siteSelector.addEventListener('change', function(e) {
                            var siteId = parseInt(e.target.value);
                            if (siteId && siteId !== db.currentSiteId) {
                                var site = db.sites.find(function(s) { return s && s.id === siteId; });
                                if (site) {
                                    SiteManager.switchSite(siteId);
                                }
                            }
                        });
                    }

                    // Edit mode button
                    var editModeBtn = document.getElementById('editModeBtn');
                    if (editModeBtn) {
                        editModeBtn.addEventListener('click', function() { 
                            MapEditor.toggleEditMode(); 
                        });
                    }

                    // Save map button
                    var saveMapBtn = document.getElementById('saveMapBtn');
                    if (saveMapBtn) {
                        saveMapBtn.addEventListener('click', function() { 
                            MapEditor.saveMap(); 
                        });
                    }

                    // Clear map button
                    var clearMapBtn = document.getElementById('clearMapBtn');
                    if (clearMapBtn) {
                        clearMapBtn.addEventListener('click', function() { 
                            MapEditor.clearMap(); 
                        });
                    }

                    // Tab switching - fix map when switching to dashboard
                    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(tab) {
                        tab.addEventListener('shown.bs.tab', function(e) {
                            var target = e.target.getAttribute('data-bs-target');
                            if (target === '#dashboard') {
                                setTimeout(function() {
                                    if (window.map) {
                                        window.map.invalidateSize(true);
                                    } else {
                                        App.initMap();
                                    }
                                }, 400);
                            }
                        });
                    });

                    // Window resize
                    window.addEventListener('resize', function() {
                        if (window.map) {
                            setTimeout(function() {
                                window.map.invalidateSize(true);
                            }, 200);
                        }
                    });
                }
            };

            // ==================== INITIALIZE ====================
            document.addEventListener('DOMContentLoaded', function() {
                console.log('DOMContentLoaded - starting app');
                App.init();
                
                // Emergency map loader
                setTimeout(function() {
                    var container = document.getElementById('map');
                    if (container && !container.querySelector('.leaflet-container')) {
                        console.log('Emergency map loader triggered');
                        App.initMap();
                    }
                }, 2000);
                
                // Second emergency loader
                setTimeout(function() {
                    var container = document.getElementById('map');
                    if (container && !container.querySelector('.leaflet-container')) {
                        console.log('Second emergency map loader triggered');
                        container.innerHTML = '';
                        container.style.height = '500px';
                        container.style.minHeight = '500px';
                        
                        if (typeof L !== 'undefined') {
                            var site = db.sites.find(function(s) { return s && s.id === db.currentSiteId; });
                            var center = [-33.4, 150.3];
                            if (site && db.siteMaps[site.id]) {
                                center = db.siteMaps[site.id].center || center;
                            }
                            
                            window.map = L.map('map', {
                                center: center,
                                zoom: 13,
                                zoomControl: true
                            });
                            
                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                attribution: '&copy; OpenStreetMap',
                                maxZoom: 19
                            }).addTo(window.map);
                            
                            L.marker(center).bindPopup('Site Map').addTo(window.map);
                            
                            setTimeout(function() {
                                if (window.map) window.map.invalidateSize(true);
                            }, 300);
                            
                            console.log('Emergency map loaded');
                        }
                    }
                }, 5000);
            });

            window.generateReport = function(type) {
                console.log('Generate report:', type);
                Utils.showToast('Info', 'Report generation coming soon', 'info');
            };

        })();
