                saveAssessment: function() {
                    var form = document.getElementById('formNewAssessment');
                    if (!form) return;
                    
                    if (!form.checkValidity()) {
                        form.classList.add('was-validated');
                        
                        var components = document.querySelectorAll('#formNewAssessment input[name="components"]:checked');
                        if (components.length === 0) {
                            var feedback = document.getElementById('componentsFeedback');
                            if (feedback) feedback.style.display = 'block';
                        }
                        return;
                    }

                    var components = Array.from(document.querySelectorAll('#formNewAssessment input[name="components"]:checked'))
                        .map(function(cb) { return cb.value; });
                    
                    if (components.length === 0) {
                        var feedback = document.getElementById('componentsFeedback');
                        if (feedback) feedback.style.display = 'block';
                        return;
                    }

                    var threatsSelect = document.getElementById('modalThreats');
                    var threats = threatsSelect ? Array.from(threatsSelect.selectedOptions).map(function(opt) { return opt.value; }) : [];

                    var photoInput = document.getElementById('modalAssessmentPhotos');
                    var photos = [];
                    if (photoInput && photoInput.files && photoInput.files.length > 0) {
                        Utils.showToast('Info', 'Processing images...', 'info');
                        Utils.convertMultipleImagesToBase64(Array.from(photoInput.files), 5).then(function(result) {
                            photos = result;
                            Utils.showToast('Success', photos.length + ' image(s) saved', 'success');
                        });
                    }

                    var newAssessment = {
                        id: Utils.generateId(),
                        siteId: db.currentSiteId,
                        date: document.getElementById('modalAssessmentDate').value,
                        assessor: document.getElementById('modalAssessorName').value,
                        description: document.getElementById('modalSiteDescription').value,
                        components: components,
                        health: document.getElementById('modalEcosystemHealth').value,
                        threats: threats,
                        photos: photos,
                        createdAt: new Date().toISOString()
                    };

                    db.assessments.push(newAssessment);
                    
                    if (Utils.saveData()) {
                        form.reset();
                        form.classList.remove('was-validated');
                        var feedback = document.getElementById('componentsFeedback');
                        if (feedback) feedback.style.display = 'none';
                        
                        var preview = document.getElementById('assessmentPhotoPreview');
