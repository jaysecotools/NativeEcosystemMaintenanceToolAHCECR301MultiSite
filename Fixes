                    siteFeatures.points.forEach(function(feature) {
                        if (feature && feature.coordinates) {
                            try {
                                var marker = L.marker(feature.coordinates, {
                                    icon: L.divIcon({
                                        className: 'custom-div-icon',
                                        html: '<div style="background-color: ' + (feature.color || '#f1c40f') + '; width: 12px; height: 12px; border-radius: 50%; border: 2px solid white;"></div>',
                                        iconSize: [16, 16],
                                        popupAnchor: [0, -8]
                                    })
                                });
                                
                                marker.featureData = feature;
                                marker.bindPopup(MapEditor.createFeaturePopup(feature));
                                window.customPointsLayer.addLayer(marker);
                            } catch (e) {
                                console.error('Error creating point marker:', e);
                            }
