                getSiteHealthData: function(siteId) {
                    if (!siteId) return this.getDefaultHealthData();
                    
                    var siteAssessments = db.assessments.filter(function(a) { return a && a.siteId === siteId; });
                    
                    var healthData = {
                        biodiversity: 78,
                        nativeCover: 65,
                        weedPressure: 22,
                        erosion: 15,
                        faunaActivity: 70,
                        waterQuality: 85,
                        previousBiodiversity: 72,
                        previousNativeCover: 60,
                        previousWeedPressure: 28,
                        previousErosion: 18,
                        previousFaunaActivity: 65,
                        previousWaterQuality: 80
                    };
                    
                    if (siteAssessments.length > 0) {
                        var sorted = siteAssessments.slice().sort(function(a, b) { return new Date(b.date) - new Date(a.date); });
                        var latest = sorted[0];
                        var previous = sorted[1] || sorted[0];
                        
                        var healthScore = function(health) {
                            switch(health) {
                                case 'excellent': return 90;
                                case 'good': return 75;
                                case 'fair': return 55;
                                case 'poor': return 30;
                                case 'degraded': return 15;
                                default: return 50;
                            }
                        };
                        
                        var latestScore = healthScore(latest.health);
                        var previousScore = healthScore(previous.health);
                        
                        healthData = {
                            biodiversity: latestScore,
                            nativeCover: latestScore - (latest.threats && latest.threats.indexOf('weeds') !== -1 ? 10 : 0),
                            weedPressure: 100 - latestScore + (latest.threats && latest.threats.indexOf('weeds') !== -1 ? 20 : 10),
                            erosion: latest.threats && latest.threats.indexOf('erosion') !== -1 ? 40 : 15,
                            faunaActivity: latestScore - 5,
                            waterQuality: latest.components && latest.components.indexOf('water') !== -1 ? latestScore : 70,
                            previousBiodiversity: previousScore,
                            previousNativeCover: previousScore - (previous.threats && previous.threats.indexOf('weeds') !== -1 ? 10 : 0),
                            previousWeedPressure: 100 - previousScore + (previous.threats && previous.threats.indexOf('weeds') !== -1 ? 20 : 10),
                            previousErosion: previous.threats && previous.threats.indexOf('erosion') !== -1 ? 40 : 15,
                            previousFaunaActivity: previousScore - 5,
                            previousWaterQuality: previous.components && previous.components.indexOf('water') !== -1 ? previousScore : 70
                        };
                        
                        Object.keys(healthData).forEach(function(key) {
                            healthData[key] = Math.min(100, Math.max(0, healthData[key]));
                        });
                    }
                    
                    return healthData;
                },

                getDefaultHealthData: function() {
                    return {
                        biodiversity: 78,
                        nativeCover: 65,
                        weedPressure: 22,
                        erosion: 15,
                        faunaActivity: 70,
                        waterQuality: 85,
                        previousBiodiversity: 72,
                        previousNativeCover: 60,
                        previousWeedPressure: 28,
                        previousErosion: 18,
                        previousFaunaActivity: 65,
                        previousWaterQuality: 80
                    };
                }
