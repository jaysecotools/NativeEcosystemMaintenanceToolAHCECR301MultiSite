                compressImage: function(base64String, maxWidth, maxHeight, quality) {
                    maxWidth = maxWidth || 800;
                    maxHeight = maxHeight || 800;
                    quality = quality || 0.7;
                    
                    return new Promise(function(resolve) {
                        var img = new Image();
                        img.onload = function() {
                            var width = img.width;
                            var height = img.height;
                            
                            if (width > height) {
                                if (width > maxWidth) {
                                    height = Math.round(height * (maxWidth / width));
                                    width = maxWidth;
                                }
                            } else {
                                if (height > maxHeight) {
                                    width = Math.round(width * (maxHeight / height));
                                    height = maxHeight;
                                }
                            }
                            
                            var canvas = document.createElement('canvas');
                            canvas.width = width;
                            canvas.height = height;
                            var ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, width, height);
                            
                            var compressedBase64 = canvas.toDataURL('image/jpeg', quality);
                            resolve(compressedBase64);
                        };
                        img.onerror = function() {
                            resolve(base64String);
                        };
                        img.src = base64String;
                    });
                },

                convertImageToBase64: function(file, maxSizeKB) {
                    maxSizeKB = maxSizeKB || 500;
                    
                    return new Promise(function(resolve, reject) {
                        if (!file || !file.type.startsWith('image/')) {
                            resolve(null);
                            return;
                        }
                        
                        if (file.size > 5 * 1024 * 1024) {
                            Utils.showToast('Warning', 'Image ' + file.name + ' exceeds 5MB and was skipped', 'warning');
                            resolve(null);
                            return;
                        }
                        
                        var reader = new FileReader();
                        reader.onload = function(e) {
                            var base64 = e.target.result;
                            Utils.compressImage(base64, 800, 800, 0.7).then(function(compressed) {
                                resolve(compressed);
                            });
                        };
                        reader.onerror = function(e) {
                            console.error('Error converting image:', e);
                            reject(null);
                        };
                        reader.readAsDataURL(file);
                    });
                },

